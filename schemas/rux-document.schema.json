{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruxel.dev/schemas/rux-document.schema.json",
  "title": "Ruxel Studio Document",
  "type": "object",
  "required": ["$schema", "metadata", "window", "assets", "theme", "root"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://ruxel.dev/schemas/rux-document.schema.json"
    },
    "metadata": {
      "type": "object",
      "required": ["schema_version", "app_name", "app_version", "target_frameworks"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "app_name": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "target_frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["iced", "egui", "slint", "dioxus", "fyne", "flet"]
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "window": {
      "type": "object",
      "required": ["title", "initial_width", "initial_height"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "initial_width": {
          "type": "number",
          "minimum": 1
        },
        "initial_height": {
          "type": "number",
          "minimum": 1
        },
        "min_width": {
          "type": "number",
          "minimum": 1
        },
        "min_height": {
          "type": "number",
          "minimum": 1
        },
        "max_width": {
          "type": "number",
          "minimum": 1
        },
        "max_height": {
          "type": "number",
          "minimum": 1
        },
        "resizable": {
          "type": "boolean",
          "default": true
        },
        "scale_mode": {
          "type": "string",
          "enum": ["logical", "physical", "scaled"],
          "default": "logical"
        },
        "transparent": {
          "type": "boolean",
          "default": false
        },
        "decorations": {
          "type": "boolean",
          "default": true
        },
        "always_on_top": {
          "type": "boolean",
          "default": false
        },
        "fullscreen": {
          "type": "boolean",
          "default": false
        },
        "position_x": {
          "type": "integer"
        },
        "position_y": {
          "type": "integer"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FontAsset"
          }
        },
        "icons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IconAsset"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImageAsset"
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_scheme": {
          "type": "string",
          "enum": ["light", "dark", "system"],
          "default": "system"
        },
        "color_palettes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "$ref": "#/$defs/ColorPalette"
            },
            "dark": {
              "$ref": "#/$defs/ColorPalette"
            }
          }
        },
        "typography": {
          "$ref": "#/$defs/TypeScale"
        },
        "border_radii": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "shadows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShadowToken"
          }
        },
        "spacing": {
          "$ref": "#/$defs/SpacingScale"
        }
      }
    },
    "root": {
      "$ref": "#/$defs/WidgetNode"
    }
  },
  "$defs": {
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "FontWeight": {
      "type": "string",
      "enum": ["thin", "extra_light", "light", "normal", "medium", "semi_bold", "bold", "extra_bold", "black"]
    },
    "FontAsset": {
      "type": "object",
      "required": ["alias", "path"],
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/$defs/FontWeight",
          "default": "normal"
        },
        "style": {
          "type": "string",
          "enum": ["normal", "italic", "oblique"],
          "default": "normal"
        }
      }
    },
    "IconAsset": {
      "type": "object",
      "required": ["alias", "path", "format"],
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": ["svg", "png"]
        }
      }
    },
    "ImageAsset": {
      "type": "object",
      "required": ["alias", "path", "format"],
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": ["svg", "png", "jpg", "webp"]
        }
      }
    },
    "ColorPalette": {
      "type": "object",
      "required": [
        "primary",
        "on_primary",
        "primary_container",
        "on_primary_container",
        "secondary",
        "on_secondary",
        "secondary_container",
        "on_secondary_container",
        "tertiary",
        "on_tertiary",
        "tertiary_container",
        "on_tertiary_container",
        "error",
        "on_error",
        "error_container",
        "on_error_container",
        "surface",
        "on_surface",
        "surface_variant",
        "on_surface_variant",
        "outline",
        "outline_variant",
        "background",
        "on_background",
        "inverse_surface",
        "inverse_on_surface",
        "inverse_primary",
        "scrim",
        "shadow"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/HexColor" },
        "on_primary": { "$ref": "#/$defs/HexColor" },
        "primary_container": { "$ref": "#/$defs/HexColor" },
        "on_primary_container": { "$ref": "#/$defs/HexColor" },
        "secondary": { "$ref": "#/$defs/HexColor" },
        "on_secondary": { "$ref": "#/$defs/HexColor" },
        "secondary_container": { "$ref": "#/$defs/HexColor" },
        "on_secondary_container": { "$ref": "#/$defs/HexColor" },
        "tertiary": { "$ref": "#/$defs/HexColor" },
        "on_tertiary": { "$ref": "#/$defs/HexColor" },
        "tertiary_container": { "$ref": "#/$defs/HexColor" },
        "on_tertiary_container": { "$ref": "#/$defs/HexColor" },
        "error": { "$ref": "#/$defs/HexColor" },
        "on_error": { "$ref": "#/$defs/HexColor" },
        "error_container": { "$ref": "#/$defs/HexColor" },
        "on_error_container": { "$ref": "#/$defs/HexColor" },
        "surface": { "$ref": "#/$defs/HexColor" },
        "on_surface": { "$ref": "#/$defs/HexColor" },
        "surface_variant": { "$ref": "#/$defs/HexColor" },
        "on_surface_variant": { "$ref": "#/$defs/HexColor" },
        "outline": { "$ref": "#/$defs/HexColor" },
        "outline_variant": { "$ref": "#/$defs/HexColor" },
        "background": { "$ref": "#/$defs/HexColor" },
        "on_background": { "$ref": "#/$defs/HexColor" },
        "inverse_surface": { "$ref": "#/$defs/HexColor" },
        "inverse_on_surface": { "$ref": "#/$defs/HexColor" },
        "inverse_primary": { "$ref": "#/$defs/HexColor" },
        "scrim": { "$ref": "#/$defs/HexColor" },
        "shadow": { "$ref": "#/$defs/HexColor" }
      }
    },
    "TypeStyle": {
      "type": "object",
      "required": ["font_family", "font_weight", "font_size", "line_height", "letter_spacing"],
      "additionalProperties": false,
      "properties": {
        "font_family": {
          "type": "string"
        },
        "font_weight": {
          "type": "string"
        },
        "font_size": {
          "type": "number",
          "minimum": 1
        },
        "line_height": {
          "type": "number",
          "minimum": 0
        },
        "letter_spacing": {
          "type": "number"
        }
      }
    },
    "TypeScale": {
      "type": "object",
      "required": [
        "display_large", "display_medium", "display_small",
        "headline_large", "headline_medium", "headline_small",
        "title_large", "title_medium", "title_small",
        "body_large", "body_medium", "body_small",
        "label_large", "label_medium", "label_small"
      ],
      "additionalProperties": false,
      "properties": {
        "display_large": { "$ref": "#/$defs/TypeStyle" },
        "display_medium": { "$ref": "#/$defs/TypeStyle" },
        "display_small": { "$ref": "#/$defs/TypeStyle" },
        "headline_large": { "$ref": "#/$defs/TypeStyle" },
        "headline_medium": { "$ref": "#/$defs/TypeStyle" },
        "headline_small": { "$ref": "#/$defs/TypeStyle" },
        "title_large": { "$ref": "#/$defs/TypeStyle" },
        "title_medium": { "$ref": "#/$defs/TypeStyle" },
        "title_small": { "$ref": "#/$defs/TypeStyle" },
        "body_large": { "$ref": "#/$defs/TypeStyle" },
        "body_medium": { "$ref": "#/$defs/TypeStyle" },
        "body_small": { "$ref": "#/$defs/TypeStyle" },
        "label_large": { "$ref": "#/$defs/TypeStyle" },
        "label_medium": { "$ref": "#/$defs/TypeStyle" },
        "label_small": { "$ref": "#/$defs/TypeStyle" }
      }
    },
    "ShadowToken": {
      "type": "object",
      "required": ["name", "offset_x", "offset_y", "blur_radius", "spread_radius", "color"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "offset_x": {
          "type": "number"
        },
        "offset_y": {
          "type": "number"
        },
        "blur_radius": {
          "type": "number",
          "minimum": 0
        },
        "spread_radius": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/HexColor"
        }
      }
    },
    "SpacingScale": {
      "type": "object",
      "required": ["none", "xs", "sm", "md", "lg", "xl", "xxl"],
      "additionalProperties": false,
      "properties": {
        "none": {
          "type": "number",
          "minimum": 0
        },
        "xs": {
          "type": "number",
          "minimum": 0
        },
        "sm": {
          "type": "number",
          "minimum": 0
        },
        "md": {
          "type": "number",
          "minimum": 0
        },
        "lg": {
          "type": "number",
          "minimum": 0
        },
        "xl": {
          "type": "number",
          "minimum": 0
        },
        "xxl": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "WidgetType": {
      "type": "string",
      "enum": [
        "v_box",
        "h_box",
        "anchor_pane",
        "border_pane",
        "grid",
        "scroll_pane",
        "split_pane",
        "tab_pane",
        "accordion",
        "button",
        "label",
        "text_input",
        "checkbox",
        "radio_button",
        "slider",
        "progress_bar",
        "combo_box",
        "table_view",
        "tree_view",
        "menu_bar",
        "menu",
        "menu_item",
        "menu_separator",
        "rectangle",
        "circle",
        "ellipse",
        "line",
        "path",
        "line_chart",
        "bar_chart",
        "pie_chart",
        "scatter_chart",
        "canvas3_d",
        "custom_component"
      ]
    },
    "TextAlign": {
      "type": "string",
      "enum": ["left", "center", "right", "justify"]
    },
    "TableColumn": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "width": { "type": "number", "minimum": 0 },
        "field": { "type": "string" }
      }
    },
    "WidgetProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "background_color": { "type": "string" },
        "border_color": { "type": "string" },
        "border_width": { "type": "number", "minimum": 0 },
        "corner_radius": { "type": "number", "minimum": 0 },
        "shadow_ref": { "type": "string" },
        "text": { "type": "string" },
        "placeholder": { "type": "string" },
        "font_alias": { "type": "string" },
        "font_size": { "type": "number", "minimum": 1 },
        "font_weight": { "$ref": "#/$defs/FontWeight" },
        "text_color": { "type": "string" },
        "text_align": { "$ref": "#/$defs/TextAlign" },
        "wrap_text": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "is_default": { "type": "boolean" },
        "is_cancel": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "min_value": { "type": "number" },
        "max_value": { "type": "number" },
        "step_value": { "type": "number" },
        "current_value": { "type": "number" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/TableColumn" }
        },
        "custom_properties": {
          "type": "object"
        }
      }
    },
    "EventHandler": {
      "type": "object",
      "required": ["handler_name"],
      "additionalProperties": false,
      "properties": {
        "handler_name": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "WidgetEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_click": { "$ref": "#/$defs/EventHandler" },
        "on_change": { "$ref": "#/$defs/EventHandler" },
        "on_hover": { "$ref": "#/$defs/EventHandler" },
        "on_submit": { "$ref": "#/$defs/EventHandler" },
        "on_focus": { "$ref": "#/$defs/EventHandler" },
        "custom_events": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/EventHandler" }
        }
      }
    },
    "WidgetBindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "items": { "type": "string" },
        "selected": { "type": "string" },
        "disabled": { "type": "string" },
        "visible": { "type": "string" },
        "custom_bindings": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "FlexDirection": {
      "type": "string",
      "enum": ["row", "column", "row_reverse", "column_reverse"]
    },
    "FlexWrap": {
      "type": "string",
      "enum": ["no_wrap", "wrap", "wrap_reverse"]
    },
    "JustifyContent": {
      "type": "string",
      "enum": ["flex_start", "flex_end", "center", "space_between", "space_around", "space_evenly"]
    },
    "AlignItems": {
      "type": "string",
      "enum": ["flex_start", "flex_end", "center", "stretch", "baseline"]
    },
    "AlignSelf": {
      "type": "string",
      "enum": ["auto", "flex_start", "flex_end", "center", "stretch", "baseline"]
    },
    "FlexContainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "$ref": "#/$defs/FlexDirection", "default": "column" },
        "wrap": { "$ref": "#/$defs/FlexWrap", "default": "no_wrap" },
        "justify_content": { "$ref": "#/$defs/JustifyContent", "default": "flex_start" },
        "align_items": { "$ref": "#/$defs/AlignItems", "default": "stretch" },
        "gap": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "GridTrack": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": ["fixed", "percentage", "fr", "auto", "min_max"]
        },
        "value": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      }
    },
    "GridContainer": {
      "type": "object",
      "required": ["columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridTrack" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridTrack" }
        },
        "column_gap": { "type": "number", "minimum": 0, "default": 0 },
        "row_gap": { "type": "number", "minimum": 0, "default": 0 },
        "justify_items": { "$ref": "#/$defs/AlignItems" },
        "align_items": { "$ref": "#/$defs/AlignItems" }
      }
    },
    "AbsolutePosition": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z_index": { "type": "integer", "default": 0 }
      }
    },
    "AnchorConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number" },
        "bottom": { "type": "number" },
        "left": { "type": "number" },
        "right": { "type": "number" }
      }
    },
    "BorderPosition": {
      "type": "string",
      "enum": ["top", "bottom", "left", "right", "center"]
    },
    "ContainerLayout": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "const": "flex" },
            "direction": { "$ref": "#/$defs/FlexDirection" },
            "wrap": { "$ref": "#/$defs/FlexWrap" },
            "justify_content": { "$ref": "#/$defs/JustifyContent" },
            "align_items": { "$ref": "#/$defs/AlignItems" },
            "gap": { "type": "number" }
          }
        },
        {
          "type": "object",
          "required": ["type", "columns", "rows"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "const": "grid" },
            "columns": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridTrack" }
            },
            "rows": {
              "type": "array",
              "items": { "$ref": "#/$defs/GridTrack" }
            },
            "column_gap": { "type": "number" },
            "row_gap": { "type": "number" },
            "justify_items": { "$ref": "#/$defs/AlignItems" },
            "align_items": { "$ref": "#/$defs/AlignItems" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "const": "absolute" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "const": "anchor" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "const": "border" }
          }
        }
      ]
    },
    "Size": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fixed", "percentage", "fill", "hug_content", "auto"]
        },
        "value": { "type": "number" }
      }
    },
    "Dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "$ref": "#/$defs/Size" },
        "height": { "$ref": "#/$defs/Size" },
        "min_width": { "type": "number", "minimum": 0 },
        "min_height": { "type": "number", "minimum": 0 },
        "max_width": { "type": "number", "minimum": 0 },
        "max_height": { "type": "number", "minimum": 0 },
        "aspect_ratio": { "type": "number", "minimum": 0 }
      }
    },
    "RectOffsets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number", "default": 0 },
        "right": { "type": "number", "default": 0 },
        "bottom": { "type": "number", "default": 0 },
        "left": { "type": "number", "default": 0 }
      }
    },
    "Spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "padding": { "$ref": "#/$defs/RectOffsets" },
        "margin": { "$ref": "#/$defs/RectOffsets" }
      }
    },
    "GridPlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column": { "type": "integer", "minimum": 0, "default": 0 },
        "column_span": { "type": "integer", "minimum": 1, "default": 1 },
        "row": { "type": "integer", "minimum": 0, "default": 0 },
        "row_span": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "FlexItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grow": { "type": "number", "minimum": 0, "default": 0 },
        "shrink": { "type": "number", "minimum": 0, "default": 1 },
        "basis": { "$ref": "#/$defs/Size" },
        "align_self": { "$ref": "#/$defs/AlignSelf", "default": "auto" }
      }
    },
    "WidgetLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container": { "$ref": "#/$defs/ContainerLayout" },
        "dimensions": { "$ref": "#/$defs/Dimensions" },
        "spacing": { "$ref": "#/$defs/Spacing" },
        "absolute": { "$ref": "#/$defs/AbsolutePosition" },
        "anchor": { "$ref": "#/$defs/AnchorConstraints" },
        "border": { "$ref": "#/$defs/BorderPosition" },
        "grid": { "$ref": "#/$defs/GridPlacement" },
        "flex_item": { "$ref": "#/$defs/FlexItem" }
      }
    },
    "WidgetNode": {
      "type": "object",
      "required": ["id", "widget_type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "widget_type": {
          "$ref": "#/$defs/WidgetType"
        },
        "slot": {
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/WidgetProperties"
        },
        "layout": {
          "$ref": "#/$defs/WidgetLayout"
        },
        "events": {
          "$ref": "#/$defs/WidgetEvents"
        },
        "bindings": {
          "$ref": "#/$defs/WidgetBindings"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WidgetNode"
          }
        }
      }
    }
  }
}
