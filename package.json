{
  "name": "ruxel-studio",
  "version": "0.1.4",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/shared-types",
    "packages/extension",
    "packages/webview"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared-types && npm --workspaces run build",
    "test": "npm --workspace=ruxel-studio test",
    "stage:release": "node scripts/stage-release.mjs",
    "stage:local": "node scripts/stage-release.mjs --local",
    "package": "node scripts/stage-release.mjs && cd packages/extension && npx vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vite": "8.3.6"
  }
}
