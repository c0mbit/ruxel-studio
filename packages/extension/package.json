{
  "name": "ruxel-studio",
  "displayName": "Ruxel Studio",
  "description": "Universal Visual UI Builder & Scene Builder for Rust and Go desktop applications",
  "version": "0.1.0",
  "publisher": "ruxel-studio",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruxel-studio/ruxel-studio"
  },
  "bugs": {
    "url": "https://github.com/ruxel-studio/ruxel-studio/issues"
  },
  "homepage": "https://github.com/ruxel-studio/ruxel-studio",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "rust",
    "gui",
    "ui-builder",
    "scene-builder",
    "iced",
    "egui",
    "slint",
    "dioxus",
    "fyne",
    "visual-editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "ruxel.ruxEditor",
        "displayName": "Ruxel Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.rux"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ruxel.restartDaemon",
        "title": "Ruxel: Restart AST Daemon"
      },
      {
        "command": "ruxel.validateCurrentDocument",
        "title": "Ruxel: Validate Active Document"
      },
      {
        "command": "ruxel.formatCurrentDocument",
        "title": "Ruxel: Format Active Document"
      },
      {
        "command": "ruxel.generateCode",
        "title": "Ruxel: Generate & Export Rust Code (ui_generated.rs & controller.rs)"
      }
    ],
    "configuration": {
      "title": "Ruxel Studio",
      "properties": {
        "ruxel.daemonPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Custom path to the rux-daemon executable binary. If null, uses bundled binary."
        },
        "ruxel.syncServerPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Custom path to the rux-sync-server executable binary."
        },
        "ruxel.defaultFramework": {
          "type": "string",
          "enum": [
            "iced",
            "egui",
            "slint",
            "dioxus",
            "fyne",
            "flet"
          ],
          "default": "iced",
          "description": "Default code generation target framework."
        },
        "ruxel.wasmAutocompile": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compile background Wasm preview on layout changes."
        },
        "ruxel.collaboration.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable real-time CRDT multiplayer synchronization."
        },
        "ruxel.collaboration.serverUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:4040",
          "description": "WebSocket server endpoint for multiplayer rooms."
        },
        "ruxel.figma.defaultToken": {
          "type": "string",
          "default": "",
          "description": "Optional default personal access token for Figma API imports."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "tsc -watch -p tsconfig.json",
    "test": "node test/binaryResolver.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@ruxel/shared-types": "*",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0"
  }
}
